{
  "info": {
    "name": "Med&Fis API - Consentimientos",
    "description": "Colección completa para pruebas del backend Med&Fis\nDesarrollado por JM Ingeniero",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080/api", "type": "string" },
    { "key": "token",    "value": "", "type": "string" },
    { "key": "token_medico", "value": "", "type": "string" },
    { "key": "consent_id",  "value": "", "type": "string" },
    { "key": "usuario_id",  "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "🔐 AUTH",
      "item": [
        {
          "name": "1. Login Admin",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 200) {",
            "  var r = pm.response.json();",
            "  pm.collectionVariables.set('token', r.token);",
            "  pm.test('Login exitoso', () => pm.expect(r.token).to.not.be.empty);",
            "  console.log('✅ Token guardado para:', r.nombre, '|', r.rol);",
            "} else {",
            "  pm.test('Login fallido - revisar credenciales', () => pm.expect(pm.response.code).to.equal(200));",
            "}"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"medfissaludintensa@gmail.com\",\n  \"password\": \"admin123456\"\n}" },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth","login"] }
          }
        },
        {
          "name": "2. Login Médico",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 200) {",
            "  var r = pm.response.json();",
            "  pm.collectionVariables.set('token_medico', r.token);",
            "  pm.test('Login médico exitoso', () => pm.expect(r.token).to.not.be.empty);",
            "  console.log('✅ Token médico guardado para:', r.nombre);",
            "} else {",
            "  pm.test('Primero crea el médico en el paso 4', () => pm.expect(pm.response.code).to.equal(200));",
            "}"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"rafael.marrero@medfis.com\",\n  \"password\": \"medico2024\"\n}" },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth","login"] }
          }
        }
      ]
    },
    {
      "name": "👥 USUARIOS / STAFF",
      "item": [
        {
          "name": "3. Listar todos los usuarios",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.expect(pm.response.code).to.equal(200));",
            "var r = pm.response.json();",
            "if (Array.isArray(r) && r.length > 0) {",
            "  pm.collectionVariables.set('usuario_id', r[0].id);",
            "  console.log('Usuarios encontrados:', r.length);",
            "}"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/usuarios", "host": ["{{base_url}}"], "path": ["usuarios"] }
          }
        },
        {
          "name": "4. Crear médico",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 200 || pm.response.code === 201) {",
            "  var r = pm.response.json();",
            "  pm.collectionVariables.set('usuario_id', r.id);",
            "  pm.test('Médico creado', () => pm.expect(r.email).to.equal('rafael.marrero@medfis.com'));",
            "  console.log('✅ Médico creado con ID:', r.id);",
            "} else {",
            "  console.log('Respuesta:', pm.response.text());",
            "}"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Dr. Rafael Eduardo Marrero Padilla\",\n  \"email\": \"rafael.marrero@medfis.com\",\n  \"password\": \"medico2024\",\n  \"rol\": \"MEDICO\"\n}" },
            "url": { "raw": "{{base_url}}/usuarios", "host": ["{{base_url}}"], "path": ["usuarios"] }
          }
        },
        {
          "name": "5. Crear auxiliar",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Auxiliar Recepción\",\n  \"email\": \"auxiliar@medfis.com\",\n  \"password\": \"auxiliar2024\",\n  \"rol\": \"AUXILIAR\"\n}" },
            "url": { "raw": "{{base_url}}/usuarios", "host": ["{{base_url}}"], "path": ["usuarios"] }
          }
        },
        {
          "name": "6. Activar o desactivar usuario",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/usuarios/{{usuario_id}}/toggle", "host": ["{{base_url}}"], "path": ["usuarios","{{usuario_id}}","toggle"] }
          }
        }
      ]
    },
    {
      "name": "📋 CONSENTIMIENTOS",
      "item": [
        {
          "name": "7. Crear consentimiento - Escleroterapia",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 200 || pm.response.code === 201) {",
            "  var r = pm.response.json();",
            "  pm.collectionVariables.set('consent_id', r.id);",
            "  pm.test('Consentimiento creado', () => pm.expect(r.radicado).to.include('ESC'));",
            "  console.log('✅ Radicado:', r.radicado, '| ID:', r.id);",
            "} else {",
            "  console.log('Error:', pm.response.text());",
            "}"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"tipo\": \"escleroterapia\",\n  \"pacienteNombre\": \"María Pérez López\",\n  \"pacienteDoc\": \"1098765432\",\n  \"pacienteTel\": \"3201234567\",\n  \"datos\": {\n    \"paciente\": {\n      \"nombre\": \"María Pérez López\",\n      \"documento\": \"1098765432\",\n      \"telefono\": \"3201234567\",\n      \"email\": \"maria@gmail.com\"\n    }\n  }\n}" },
            "url": { "raw": "{{base_url}}/consentimientos", "host": ["{{base_url}}"], "path": ["consentimientos"] }
          }
        },
        {
          "name": "8. Crear consentimiento - Sueroterapia",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 200 || pm.response.code === 201) {",
            "  var r = pm.response.json();",
            "  console.log('✅ Radicado:', r.radicado);",
            "}"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"tipo\": \"sueroterapia\",\n  \"pacienteNombre\": \"Carlos Rodríguez Gómez\",\n  \"pacienteDoc\": \"1020304050\",\n  \"pacienteTel\": \"3109876543\",\n  \"datos\": {}\n}" },
            "url": { "raw": "{{base_url}}/consentimientos", "host": ["{{base_url}}"], "path": ["consentimientos"] }
          }
        },
        {
          "name": "9. Listar todos los consentimientos",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.expect(pm.response.code).to.equal(200));",
            "var r = pm.response.json();",
            "console.log('Total consentimientos:', Array.isArray(r) ? r.length : 'N/A');"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/consentimientos", "host": ["{{base_url}}"], "path": ["consentimientos"] }
          }
        },
        {
          "name": "10. Ver consentimiento por ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/consentimientos/{{consent_id}}", "host": ["{{base_url}}"], "path": ["consentimientos","{{consent_id}}"] }
          }
        },
        {
          "name": "11. Aprobar consentimiento (token médico)",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 200) {",
            "  var r = pm.response.json();",
            "  pm.test('Estado APROBADO', () => pm.expect(r.estado).to.equal('APROBADO'));",
            "  console.log('✅ Aprobado por:', r.aprobadoPor);",
            "} else {",
            "  console.log('Error:', pm.response.status, pm.response.text());",
            "}"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_medico}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"medico\": \"Dr. Rafael Eduardo Marrero Padilla\"\n}" },
            "url": { "raw": "{{base_url}}/consentimientos/{{consent_id}}/aprobar", "host": ["{{base_url}}"], "path": ["consentimientos","{{consent_id}}","aprobar"] }
          }
        },
        {
          "name": "12. Rechazar consentimiento (token médico)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_medico}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"motivo\": \"Paciente presenta contraindicación por embarazo\",\n  \"medico\": \"Dr. Rafael Eduardo Marrero Padilla\"\n}" },
            "url": { "raw": "{{base_url}}/consentimientos/{{consent_id}}/rechazar", "host": ["{{base_url}}"], "path": ["consentimientos","{{consent_id}}","rechazar"] }
          }
        },
        {
          "name": "13. Anular consentimiento (solo ADMIN)",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 200) {",
            "  pm.test('Consentimiento anulado', () => pm.expect(pm.response.json().estado).to.equal('ANULADO'));",
            "}"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/consentimientos/{{consent_id}}/anular", "host": ["{{base_url}}"], "path": ["consentimientos","{{consent_id}}","anular"] }
          }
        },
        {
          "name": "14. Buscar consentimiento por nombre o doc",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/consentimientos?q=María", "host": ["{{base_url}}"], "path": ["consentimientos"], "query": [{ "key": "q", "value": "María" }] }
          }
        },
        {
          "name": "15. Enviar notificación email",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"emailPaciente\": \"maria@gmail.com\"\n}" },
            "url": { "raw": "{{base_url}}/consentimientos/{{consent_id}}/enviar-notificacion", "host": ["{{base_url}}"], "path": ["consentimientos","{{consent_id}}","enviar-notificacion"] }
          }
        }
      ]
    },
    {
      "name": "🔔 NOTIFICACIONES",
      "item": [
        {
          "name": "16. Listar notificaciones",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.expect(pm.response.code).to.equal(200));",
            "var r = pm.response.json();",
            "console.log('Notificaciones:', Array.isArray(r) ? r.length : r);"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/notificaciones", "host": ["{{base_url}}"], "path": ["notificaciones"] }
          }
        }
      ]
    }
  ]
}
